  "shortcuts": [
    {
      "name": "Random Pick",
      "short_name": "Random",
      "description": "Get a random movie or show",
      "url": "/random",
      "icons": [{ "src": "/icons/shortcut-random.png", "sizes": "96x96" }]
    },
    {
      "name": "Spinner",
      "short_name": "Spinner",
      "description": "Spin to decide what to watch",
      "url": "/spinner",
