{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "watchedthis",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_names": false,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
    "vars": {
    "CRON_SECRET": "593901045e006bb555b9bee05717691f",
    "NEXT_PUBLIC_APP_URL": "https://watchedthis.com",
    "NEXT_PUBLIC_BASE_URL": "https://watchedthis.com",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "267888282562-dhd8cd2t8qcsf1ga1c093338g7vt8vl5.apps.googleusercontent.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://ouhkvfyeqaxqbnclinfr.supabase.co",
    "TMDB_BASE_URL": "https://api.themoviedb.org/3"
  }
}
